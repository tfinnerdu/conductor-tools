CONDUCTOR_URL=http://localhost:8080
CONDUCTOR_API_KEY=
DATABASE_URL=postgresql://conductor_companion:password@localhost:5432/conductor_companion
PORT=5007
FLASK_DEBUG=true
SERVICE_VERSION=1.2.0

# SHOW_MOCK — opt-in mock mode for offline testing.
# Unset (default): every integration makes real calls; errors surface.
# Set to 1/true/yes: every integration returns fixture data; the navbar
# shows a MOCK chip and the X-Mock-Mode response header is emitted.
# All-or-nothing — there is no per-integration override.
SHOW_MOCK=

# Ethos Integration
ETHOS_URL=
ETHOS_API_KEY=

# Salesforce Integration
# Connected App credentials (OAuth2 username/password flow)
SF_USERNAME=conductor-svc@doane.edu
SF_PASSWORD=
SF_SECURITY_TOKEN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# SF_INSTANCE_URL is derived automatically from the login response;
# set it here only if you need to override (e.g. sandbox vs production).
SF_INSTANCE_URL=

# DOB Repair — optional SQL Server fetch source (round 2, alternative to CSV
# upload). Leave all unset to keep DOB Repair CSV-only. DOB_RECONCILE_SQL_FILE
# points at a .sql file you draft and own — a single read-only SELECT/WITH
# statement whose output columns match app/dob_detector.py's DEFAULT_COLUMNS
# (person_id, last_name, first_name, middle_name, birth_date, addr_line1,
# city, state, zip, email, phone, origin, created_date). See
# docs/dob_reconcile_query.example.sql for a starting template.
DOB_RECONCILE_INPUT_CSV=
DOB_RECONCILE_SQL_FILE=
DOB_RECONCILE_DB_SERVER=
DOB_RECONCILE_DB_NAME=
DOB_RECONCILE_DB_USER=
DOB_RECONCILE_DB_PASSWORD=
DOB_RECONCILE_DB_DRIVER=ODBC Driver 17 for SQL Server
# Grant DOB_RECONCILE_DB_USER SELECT-only permission on whatever reporting
# views the query touches — that DB-level permission is the real safety
# boundary, not the app's own read-only-statement guard. See warning.md.
DOB_RECONCILE_DB_ENCRYPT=yes
DOB_RECONCILE_DB_TRUST_SERVER_CERT=yes

# Digest Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_EMAIL_FROM=conductor-companion@doane.edu
DIGEST_EMAIL_TO=
GCHAT_WEBHOOK_URL=
